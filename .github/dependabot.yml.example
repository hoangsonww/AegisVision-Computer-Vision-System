# ──────────────────────────────────────────────────────────────────────────
# Dependabot version updates — DISABLED BY DEFAULT (this file is a TEMPLATE).
#
# Dependabot only ever reads `.github/dependabot.yml`. While this file keeps
# its `.example` suffix it is invisible to Dependabot, so there are NO
# scheduled runs and NO version-update PRs. This is the reliable way to fully
# turn version updates off — `open-pull-requests-limit: 0` does NOT do that
# (Dependabot still runs on schedule, it just opens 0 PRs).
#
# TO ENABLE (e.g. after forking this template):
#
#     mv .github/dependabot.yml.example .github/dependabot.yml
#     git commit -am "ci: enable Dependabot version updates"
#
# Per-ecosystem tuning (see each block below):
#     open-pull-requests-limit: 10  → normal updates (the default shipped here)
#     open-pull-requests-limit: 0   → pause that ecosystem's version PRs
#     delete a `- package-ecosystem:` block → drop that ecosystem entirely
#
# Dependabot *security / CVE* alerts and security-update PRs are SEPARATE:
# they come from repo Settings (Security → Code security), not this file, and
# keep working whether or not this template is enabled.
# ──────────────────────────────────────────────────────────────────────────
version: 2
updates:
  - package-ecosystem: gomod
    directory: /
    schedule:
      interval: weekly
      day: monday
    open-pull-requests-limit: 10 # 0 to pause this ecosystem
    labels:
      - dependencies
      - go
    reviewers:
      - hoangsonww
    commit-message:
      prefix: chore
      include: scope

  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
      day: monday
    open-pull-requests-limit: 10 # 0 to pause this ecosystem
    labels:
      - dependencies
      - ci
    reviewers:
      - hoangsonww
    commit-message:
      prefix: chore
      include: scope

  - package-ecosystem: docker
    directory: /services/api-gateway
