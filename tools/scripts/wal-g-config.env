# WAL-G environment for Postgres point-in-time-recovery backups. Mounted
# into the Patroni pods via the postgres-credentials Secret. The base
# backup is taken nightly via the Patroni built-in cron; WAL archives
# stream continuously via `archive_command = wal-g wal-push %p`.
WALG_S3_PREFIX=s3://aegis-postgres-wal/
WALG_COMPRESSION_METHOD=brotli
WALG_DELTA_MAX_STEPS=7
PGDATA=/home/postgres/pgdata
AWS_REGION=us-east-1
# Encryption — server-side via SSE-KMS so WAL is encrypted at rest.
WALG_S3_SSE_KMS_ID=alias/aegis-wal-kek
WALG_S3_SSE=aws:kms
